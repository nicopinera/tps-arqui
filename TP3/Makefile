# Makefile del TP3 (US-101).
# La sintesis, implementacion y programacion de la placa se hacen desde la GUI
# de Vivado 2025.2 (ver README.md). Los objetivos de simulacion se completan en US-102.

TB  ?=
SIM ?= xsim

.PHONY: help sim sim-all test-py

help:
	@echo "Objetivos:"
	@echo "  make sim TB=<tb> [SIM=xsim|icarus]  Simula un testbench (US-102)"
	@echo "  make sim-all [SIM=xsim|icarus]      Corre todos los testbenches (US-102)"
	@echo "  make test-py                        Corre los tests de tools/ (US-102)"

sim:
	@echo "sim: pendiente de US-102" && exit 1

sim-all:
	@echo "sim-all: pendiente de US-102" && exit 1

test-py:
	@echo "test-py: pendiente de US-102" && exit 1
